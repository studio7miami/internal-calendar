# Google Calendar — app OAuth client only (web client). Each admin connects their Google account in the app;
# access/refresh tokens are stored in Supabase table public.google_tokens (not in .env).
# Create credentials: Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI must match exactly, e.g. http://127.0.0.1:8000/api/integrations/google/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/google/callback
# GOOGLE_CALENDAR_TIMEZONE=America/New_York
