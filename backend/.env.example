# Copy to .env and fill in secrets. Do not commit .env.
# Supabase: Settings → API → Project URL and service role key (server only).

SUPABASE_URL=https://YOUR_PROJECT_REF.supabase.co
SUPABASE_SERVICE_KEY=

JWT_SECRET=
# Bootstrap seed: first sign-in admin. Use the same address as PRIMARY_ADMIN_EMAIL so there is exactly one admin account.
ADMIN_EMAIL=
ADMIN_PASSWORD=

# Single administrator (only this email may have role `admin`). Optional; defaults to seven@studio7.miami.
# PRIMARY_ADMIN_EMAIL=seven@studio7.miami
# Legacy alias if PRIMARY_ADMIN_EMAIL is unset:
# SUPER_ADMIN_EMAIL=

# Optional
FRONTEND_URL=http://localhost:3000

# Public https origin of this API (no path). Invite emails use {API_PUBLIC_ORIGIN}/api/public/brand-logo.png for the logo.
# On Render, RENDER_EXTERNAL_URL is usually set. See GET /api/public/brand-logo.png
# API_PUBLIC_ORIGIN=https://your-api.example.com

# Invite magic links + booking approved/denied emails use the same transport when configured.
# Invite magic links — email the new teammate when configured (otherwise link is logged server-side only).
# Resend (recommended): https://resend.com — verify your sending domain, create API key.
# RESEND_API_KEY=re_xxxx
# INVITE_FROM_EMAIL=Studio 7 Miami <onboarding@your-verified-domain.com>
# INVITE_EMAIL_ORG_NAME=Studio 7 Miami
# Optional subject override (placeholders: {org} {inviter} {inviter_or_team})
# INVITE_EMAIL_SUBJECT={inviter} invited you to {org}
# Optional: absolute logo URL for invite HTML (overrides API_PUBLIC_ORIGIN / FRONTEND_URL defaults)
# INVITE_EMAIL_LOGO_URL=https://your-app.com/brand/logo.png
#
# Or SMTP (e.g. Google Workspace app password):
# SMTP_HOST=smtp.gmail.com
# SMTP_PORT=587
# SMTP_USER=you@studio7.miami
# SMTP_PASSWORD=app-password
# SMTP_USE_TLS=true
# INVITE_FROM_EMAIL=Studio 7 Miami <you@studio7.miami>
# CORS_ORIGINS=https://your-frontend.com
# MFA_ISSUER_NAME=Studio 7 Miami
# ANTHROPIC_API_KEY=

# Google Calendar — app OAuth client only (web client). Each admin connects their Google account in the app;
# access/refresh tokens are stored in Supabase table public.google_tokens (not in .env).
# OAuth consent screen (APIs & Services → OAuth consent screen) must include the sensitive scope “Google Calendar API …/auth/calendar”
# so users see calendar access on the consent page. In Testing mode, add test users in Google Cloud.
# Create credentials: Google Cloud Console → APIs & Services → Credentials → OAuth client ID (Web application).
# Authorized redirect URI must match exactly, e.g. http://127.0.0.1:8000/api/integrations/google/callback
# GOOGLE_OAUTH_CLIENT_ID=
# GOOGLE_OAUTH_CLIENT_SECRET=
# GOOGLE_OAUTH_REDIRECT_URI=http://127.0.0.1:8000/api/integrations/google/callback
# GOOGLE_CALENDAR_TIMEZONE=America/New_York
# Inbound sync: pull Acuity/Cal.com (etc.) from mapped Google calendars into Studio bookings (runs automatically in the API process).
# GOOGLE_INBOUND_SYNC_INTERVAL_SEC=120
# How many days back / forward to list events from Google (default past year + 120d ahead).
# GOOGLE_INBOUND_SYNC_PAST_DAYS=365
# GOOGLE_INBOUND_SYNC_FUTURE_DAYS=120
