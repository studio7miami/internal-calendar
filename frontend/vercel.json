{
  "redirects": [
    {
      "source": "/booking/index.html",
      "destination": "/",
      "permanent": true,
      "has": [{ "type": "host", "value": "book.studio7.miami" }]
    },
    {
      "source": "/booking",
      "destination": "/",
      "permanent": true,
      "has": [{ "type": "host", "value": "book.studio7.miami" }]
    },
    {
      "source": "/login",
      "destination": "/",
      "permanent": true,
      "has": [{ "type": "host", "value": "book.studio7.miami" }]
    },
    {
      "source": "/login/",
      "destination": "/",
      "permanent": true,
      "has": [{ "type": "host", "value": "book.studio7.miami" }]
    }
  ],
  "rewrites": {
    "beforeFiles": [
      {
        "source": "/api/(.*)",
        "destination": "https://api.studio7.miami/api/$1"
      },
      {
        "source": "/",
        "has": [{ "type": "host", "value": "book.studio7.miami" }],
        "destination": "/booking/index.html"
      },
      {
        "source": "/:path((?!booking/|brand/|static/|api/).*)",
        "has": [{ "type": "host", "value": "book.studio7.miami" }],
        "destination": "/booking/index.html"
      }
    ],
    "afterFiles": [
      {
        "source": "/(.*)",
        "destination": "/index.html"
      }
    ]
  }
}
